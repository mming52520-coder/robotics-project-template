{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesignPackage v1",
  "type": "object",
  "required": [
    "schema_version",
    "brief_id",
    "assumptions",
    "system_architecture",
    "interfaces",
    "algorithm_plan",
    "hardware_functional_plan",
    "safety_plan",
    "verification_plan",
    "open_decisions"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "brief_id": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array"},
    "system_architecture": {"type": "object"},
    "interfaces": {"type": "array", "minItems": 1},
    "algorithm_plan": {"type": "array", "minItems": 1},
    "hardware_functional_plan": {"type": "array", "minItems": 1},
    "safety_plan": {"type": "object"},
    "verification_plan": {"type": "object"},
    "open_decisions": {"type": "array"}
  }
}
