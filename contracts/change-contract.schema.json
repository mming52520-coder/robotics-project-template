{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded ChangeContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "design_package_ref",
    "design_package_sha256",
    "base_revision",
    "objective",
    "in_scope",
    "out_of_scope",
    "allowed_paths",
    "affected_requirement_ids",
    "invariants",
    "required_test_ids",
    "stop_conditions"
  ],
  "properties": {
    "change_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "design_package_ref": {"$ref": "#/$defs/text"},
    "design_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "objective": {"$ref": "#/$defs/text"},
    "in_scope": {"$ref": "#/$defs/texts"},
    "out_of_scope": {"$ref": "#/$defs/texts"},
    "allowed_paths": {"$ref": "#/$defs/texts"},
    "affected_requirement_ids": {"$ref": "#/$defs/ids"},
    "invariants": {"$ref": "#/$defs/texts"},
    "required_test_ids": {"$ref": "#/$defs/ids"},
    "stop_conditions": {"$ref": "#/$defs/texts"}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "texts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"}
    }
  }
}
